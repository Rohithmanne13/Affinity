# =============================================================================
# Personalized Content Ranking — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.

# ----- Paths -----
PROJECT_ROOT=.
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
CONFIG_DIR=./configs

# ----- MLflow -----
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_PREFIX=content-ranking

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ----- Spark -----
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g

# ----- Model -----
DEFAULT_MODEL=xgboost
DEFAULT_TOP_K=10

# ----- Random Seed -----
RANDOM_SEED=42
