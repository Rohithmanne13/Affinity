# =============================================================================
# Personalized Content Ranking — .gitignore
# =============================================================================

# ----- Data (never commit raw/processed data) -----
data/raw/*
data/processed/*
data/features/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep

# ----- Model Artifacts -----
artifacts/*
!artifacts/.gitkeep

# ----- MLflow -----
mlruns/
mlartifacts/

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# ----- Virtual Environments -----
.venv/
venv/
env/
ENV/

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Jupyter -----
.ipynb_checkpoints/

# ----- Testing -----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ----- Environment -----
.env
.env.local

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Docker -----
*.log

# ----- Temp -----
tmp/
temp/
*.tmp
